# GenVault — local / CI only
# Offline product: no Cognito, database URL, or Redis required.
# Copy to .env.local only if a script needs overrides. Never commit secrets.

# Optional: Android SDK (also set in shell / Android Studio)
# ANDROID_HOME=
# JAVA_HOME=

# Optional: Windows code signing (CI secrets, not this file)
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
