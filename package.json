{
  "name": "genvault",
  "version": "2.1.0",
  "private": true,
  "description": "GenVault v2.1.0 — Offline Authentication Vault by GenXis Innovations",
  "author": "GenXis Innovations <genxisinnovation@outlook.com>",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 9999",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "build:release": "powershell -ExecutionPolicy Bypass -File ./scripts/build-release.ps1",
    "build:release:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/build-release.ps1 -Clean",
    "build:msi": "powershell -ExecutionPolicy Bypass -File ./scripts/build-release.ps1 -MsiOnly",
    "build:msi:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/build-release.ps1 -MsiOnly -Clean",
    "build:msi:sign": "powershell -ExecutionPolicy Bypass -File ./scripts/build-release.ps1 -MsiOnly -Sign",
    "build:msix": "powershell -ExecutionPolicy Bypass -File ./scripts/build-msix.ps1",
    "build:msix:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/build-msix.ps1 -Clean",
    "build:msix:sign": "powershell -ExecutionPolicy Bypass -File ./scripts/build-msix.ps1 -Sign -Store:$false",
    "build:msix:fast": "powershell -ExecutionPolicy Bypass -File ./scripts/build-msix.ps1 -SkipTests",
    "test": "jest --runTestsByPath src/tests/security.test.ts src/tests/e2e.smoke.test.ts --passWithNoTests",
    "test:security": "jest --runTestsByPath src/tests/security.test.ts --verbose",
    "test:e2e": "jest --runTestsByPath src/tests/e2e.smoke.test.ts --verbose && cargo test --manifest-path src-tauri/Cargo.toml --test e2e_smoke --locked --target-dir target -- --test-threads=1"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-biometric": "^2.3.2",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.370.0",
    "next": "^14.2.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.12.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
